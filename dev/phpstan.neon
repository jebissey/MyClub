includes:
    - ../WebSite/vendor/efabrica/phpstan-latte/rules.neon

parameters:
    level: max
    paths:
        - ../WebSite/app
        - test        
        - tests        
        - tools
    excludePaths:
        - tools/phpstan
    latte:
        collectedPaths:
            - ../WebSite/app/modules
        resolveAllPossiblePaths: true
        reportUnanalysedTemplates: false

services:
#    - 
#        class: tools/phpstan/ViewsRenderTemplateResolver
#        arguments:
#            modulesDir: %currentWorkingDirectory%/app/modules