includes:
    - ../WebSite/vendor/efabrica/phpstan-latte/rules.neon

parameters:
    level: max
    paths:
        - ../WebSite/app
        - test        
        - tests        
        - tools
    excludePaths:
        - tools/phpstan
    latte:
        collectedPaths:
            - ../WebSite/app/modules
        resolveAllPossiblePaths: true
        reportUnanalysedTemplates: false
        filters:
            version: 'Closure(string): string'
            formatFileSize: 'Closure(int): string'
            longDate: 'Closure(string): string'
        functions: []
    ignoreErrors:
        -
            message: '#^Call to function array_key_exists\(\) with .+ will always evaluate to (true|false)\.$#s'
            path: *.latte
        -
            message: '#^Call to function unset\(\) contains undefined variable \$.+_args\.$#u'
            path: *.latte
services:
    - 
        class: MyClub\Dev\PhpStan\ViewsRenderTemplateResolver
        arguments:
            modulesDir: %currentWorkingDirectory%/app/modules