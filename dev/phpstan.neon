includes:
    - ../WebSite/vendor/efabrica/phpstan-latte/rules.neon

parameters:
    level: max
    paths:
        - ../WebSite/app
        - test        
        - tests        
        - tools
    excludePaths:
        - tools/phpstan
    latte:
        collectedPaths:
            - ../WebSite/app/modules
        resolveAllPossiblePaths: true
        reportUnanalysedTemplates: false
        filters:
            version: 'Closure(string): string'
        functions: []

services:
    - 
        class: MyClub\Dev\PhpStan\ViewsRenderTemplateResolver
        arguments:
            modulesDir: %currentWorkingDirectory%/app/modules