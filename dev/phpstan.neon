includes:
    - ../WebSite/vendor/efabrica/phpstan-latte/rules.neon
#    - ../WebSite/vendor/shipmonk/dead-code-detector/rules.neon

parameters:
    level: max
    paths:
        - ../WebSite/app
        - test
        - tests
        - tools
    excludePaths:
        - tools/phpstan
    latte:
        collectedPaths:
            - ../WebSite/app/modules
        resolveAllPossiblePaths: true
        reportUnanalysedTemplates: false
        filters:
            version: 'Closure(string): string'
            formatFileSize: 'Closure(int): string'
            longDate: 'Closure(string): string'
            longDateTime: 'Closure(string): string'
            shortDate: 'Closure(string): string'
            shortDateTime: 'Closure(string): string'
            extractFirstElement: 'Closure(string): string'
            json: 'Closure(mixed): (string|false)'
            nl2br: 'Closure(mixed): string'
            urlencode: 'Closure(mixed): string'
            dayName: 'Closure(DateTimeInterface): string'
            readableDuration: 'Closure(mixed): string'
        functions:
            buildUrl: 'Closure(Latte\Runtime\Template, array<string, mixed>): string'
    ignoreErrors:
        -
            messages:
                - '#^If condition is always (true|false)\.$#'
                - '#^Result of && is always (true|false)\.$#'
                - '#^Strict comparison using (===|!==) between .+ will always evaluate to (true|false)\.$#'
                - '#^Offset .[a-zA-Z]+. on .+ (on left side of \?\?|in isset\(\)) .+#s'
            paths:
                - %currentWorkingDirectory%/app/modules/Common/views/dataTable.latte
            reportUnmatched: false
        -
            message: '#^Call to function array_key_exists\(\) with .+ will always evaluate to (true|false)\.$#s'
            path: %currentWorkingDirectory%/app/*.latte
            reportUnmatched: false
        -
            message: '#^Call to function unset\(\) contains undefined variable \$.+_args\.$#u'
            path: %currentWorkingDirectory%/app/*.latte
            reportUnmatched: false

services:
    -
        class: MyClub\Dev\PhpStan\ViewsRenderTemplateResolver
        arguments:
            modulesDir: %currentWorkingDirectory%/app/modules