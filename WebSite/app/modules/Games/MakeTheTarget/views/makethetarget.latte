{layout '../../../Common/views/layout.latte'}

{block title}{='makethetarget.title'|translate}{/block}

{block head}
<style>
    .tile {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 70px;
        height: 70px;
        margin: 6px;
        font-size: 1.6rem;
        font-weight: bold;
        border: 3px solid #333;
        border-radius: 12px;
        background: linear-gradient(145deg, #f8f1e3, #e8d9b8);
        cursor: pointer;
        user-select: none;
        transition: all 0.2s ease;
        box-shadow: 2px 2px 6px rgba(0,0,0,0.15);
    }

    .tile:hover:not(.used):not(.selected) {
        transform: scale(1.08);
        box-shadow: 3px 3px 10px rgba(0,0,0,0.25);
    }

    .tile.selected {
        background: linear-gradient(145deg, #4fc3f7, #0288d1);
        color: white;
        border-color: #01579b;
        transform: scale(1.1);
    }

    .tile.used {
        background: #ccc;
        color: #888;
        text-decoration: line-through;
        cursor: not-allowed;
        opacity: 0.55;
        transform: none;
    }

    .tile.result-tile {
        background: linear-gradient(145deg, #a5d6a7, #66bb6a);
        border-color: #2e7d32;
    }

    .tile.result-tile.selected {
        background: linear-gradient(145deg, #4fc3f7, #0288d1);
        border-color: #01579b;
    }

    .op-btn {
        width: 60px;
        height: 60px;
        margin: 6px;
        font-size: 1.8rem;
        font-weight: bold;
        border-radius: 50%;
        border: 3px solid #555;
        background: #fff;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .op-btn:hover:not(:disabled) {
        background: #ffeb3b;
        transform: scale(1.1);
    }

    .op-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .op-btn.selected {
        background: #ff9800;
        color: white;
        border-color: #e65100;
    }

    #target-display {
        font-size: 2.8rem;
        font-weight: 800;
        color: #c62828;
        letter-spacing: 2px;
    }

    .history-line {
        font-family: monospace;
        font-size: 1.15rem;
        padding: 4px 0;
        border-bottom: 1px dashed #ddd;
    }

    .history-line.exact {
        color: #2e7d32;
        font-weight: bold;
    }

    #solution-box {
        background: #fff8e1;
        border: 2px solid #ffc107;
        border-radius: 10px;
        padding: 1rem;
        margin-top: 1.5rem;
        display: none;
        white-space: pre-wrap;
        font-family: monospace;
        font-size: 1.05rem;
    }

    .btn-action {
        min-width: 140px;
    }
</style>
{/block}

{block navbar}
    {include '../../../Common/views/navbar/home.latte'}
{/block}

{block content}
<div class="container mt-3">
    <h1 class="text-center mb-3">🔢 {='makethetarget.title'|translate|upper} 🔢</h1>

    <div class="bg-light rounded p-3 mb-4">
        <h4>{='makethetarget.rules'|translate}</h4>
        <ul class="mb-0">
            <li>{='makethetarget.rule1'|translate}</li>
            <li>{='makethetarget.rule2'|translate|noescape}</li>
            <li>{='makethetarget.rule3'|translate}</li>
            <li>{='makethetarget.rule4'|translate}</li>
            <li>{='makethetarget.rule5'|translate}</li>
        </ul>
    </div>

    <div class="d-flex flex-wrap gap-2 justify-content-center mb-4">
        <button id="btn-draw" class="btn btn-primary btn-lg btn-action">
            🎲 {='makethetarget.draw_tiles'|translate}
        </button>
        <button id="btn-solution" class="btn btn-warning btn-lg btn-action" disabled>
            💡 {='makethetarget.solution'|translate}
        </button>
        <button id="btn-reset" class="btn btn-outline-secondary btn-lg btn-action" disabled>
            ↺ {='makethetarget.restart'|translate}
        </button>
    </div>

    <div class="text-center mb-4">
        <div class="text-muted">{='makethetarget.target'|translate}</div>
        <div id="target-display">—</div>
    </div>

    <div class="text-center mb-3">
        <h5>{='makethetarget.tiles'|translate}</h5>
        <div id="tiles-container" class="d-flex flex-wrap justify-content-center">
        </div>
    </div>

    <div class="text-center mb-4">
        <h5>{='makethetarget.operation'|translate}</h5>
        <div id="ops-container">
            <button class="op-btn" data-op="+" disabled>+</button>
            <button class="op-btn" data-op="-" disabled>−</button>
            <button class="op-btn" data-op="*" disabled>×</button>
            <button class="op-btn" data-op="/" disabled>÷</button>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <strong>{='makethetarget.history'|translate}</strong>
            <span id="move-counter" class="badge bg-secondary float-end">{='makethetarget.operation_count'|translate|replace:'%d','0'}</span>
        </div>
        <div class="card-body" id="history-box">
            <em class="text-muted">{='makethetarget.no_operation_yet'|translate}</em>
        </div>
    </div>

    <div id="solution-box"></div>

    <div id="end-message" class="text-center mt-3" style="display:none;"></div>
</div>
{/block}

{block scripts}
<script>
    window.i18n ??= {};
    window.i18n['makethetarget.no_operation_yet'] = {='makethetarget.no_operation_yet'|translate};
    window.i18n['makethetarget.operation_count'] = {='makethetarget.operation_count'|translate};
    window.i18n['makethetarget.operations_count'] = {='makethetarget.operations_count'|translate};
    window.i18n['makethetarget.target_reached'] = {='makethetarget.target_reached'|translate};
    window.i18n['makethetarget.obtained_in'] = {='makethetarget.obtained_in'|translate};
    window.i18n['makethetarget.new_game'] = {='makethetarget.new_game'|translate};
    window.i18n['makethetarget.solution_found'] = {='makethetarget.solution_found'|translate};
    window.i18n['makethetarget.best_result'] = {='makethetarget.best_result'|translate};
    window.i18n['makethetarget.no_combination'] = {='makethetarget.no_combination'|translate};

    window.makeTheTargetConfig = {
        sessionId: {$sessionId}
    };
</script>
<script type="module" src="{='/app/modules/Games/MakeTheTarget/js/main.js'|version}"></script>
{/block}
