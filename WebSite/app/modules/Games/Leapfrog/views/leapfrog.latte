{layout '../../../Common/views/layout.latte'}

{block title}{$i18n['title']}{/block}

{block head}
    <style>
        .sheep-col {
            min-height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .bergerie {
            background-color: #f3e9d2;
        }

        .pre {
            background-color: #baf2bb;
        }

        .separation {
            background-color: #ffffff;
        }

        .sheep {
            max-width: 100%;
            height: auto;
            cursor: pointer;
            transition: transform 0.2s ease;
        }

        .sheep:hover {
            transform: scale(1.05);
            cursor: grab;
        }

        .sheep:active {
            cursor: grabbing;
        }
    </style>
{/block}

{block navbar}
    {include '../../../Common/views/navbar/home.latte'}
{/block}

{block content}
<h1>🐑 {$i18n['title']|upper} 🐑</h1>
<div class="bg-light rounded">
    <h3>{$i18n['goal']}</h3>
    <h4>{$i18n['clickHint']}</h4>
    <h5>{$i18n['rulesTitle']}</h5>
    <ul>
        <li>{$i18n['rule1']}</li>
        <li>{$i18n['rule2']}</li>
        <li>{$i18n['rule3']}</li>
        <li>{$i18n['rule4']}</li>
    </ul>
</div>
<div id="sheep-container"></div>
<div id="gameboard-container">
    <h2>{$i18n['movesOne']|replace:'{count}','0'}</h2>
</div>
{/block}

{block scripts}
<script>window.sessionId = {$sessionId};</script>
<script>window.leapfrogI18n = {$i18n};</script>
<script src="{='/app/modules/Games/Leapfrog/js/leapfrog.js'|version}"></script>
{/block}