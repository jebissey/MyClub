{extends 'webmaster.latte'}

{block title}{='webmaster.installations.title'|translate}{/block}

{block content}
    {if $installations === []}
        <div class="text-center mt-5">
            <div class="alert alert-info">
                <h5>{='webmaster.installations.none_title'|translate}</h5>
                <p>{='webmaster.installations.none_text'|translate}</p>
            </div>
        </div>
    {else}
        {include '../../Common/views/dataTable.latte',
            'items' => $installations,
        }
    {/if}
{/block}