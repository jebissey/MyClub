{layout '../../Common/views/layout.latte'}

{var $adminMenuItems = [
    new app\modules\Common\valueObjects\MenuItem(
        href: '/communication',
        label: 'navbar.admin.communication_manager',
        icon: '📢',
        visible: $isCommunicationManager
    ),
    new app\modules\Common\valueObjects\MenuItem(
        href: '/eventManager',
        label: 'navbar.admin.event_manager',
        icon: '🗓️',
        visible: $isEventManager
    ),
    new app\modules\Common\valueObjects\MenuItem(
        href: '/designer',
        label: 'navbar.admin.designer',
        icon: '🎨',
        visible: $isDesigner
    ),
    new app\modules\Common\valueObjects\MenuItem(
        href: '/redactor',
        label: 'navbar.admin.redactor',
        icon: '✍️',
        visible: $isRedactor
    ),
    new app\modules\Common\valueObjects\MenuItem(
        href: '/personManager',
        label: 'navbar.admin.person_manager',
        icon: '📇',
        visible: $isPersonManager
    ),
    new app\modules\Common\valueObjects\MenuItem(
        href: '/visitorInsights',
        label: 'navbar.admin.visitor_insights',
        icon: '🔍',
        visible: $isVisitorInsights
    ),
    new app\modules\Common\valueObjects\MenuItem(
        href: '/webmaster',
        label: 'navbar.admin.webmaster',
        icon: '🛠️',
        visible: $isWebmaster
    ),
    new app\modules\Common\valueObjects\MenuItem(
        href: '/backupAll',
        label: 'navbar.admin.backup_manager',
        icon: '💾',
        visible: $isBackupManager
    ),
]}

{block navbar}
    {include '../../Common/views/navbar/admin.latte', items: $adminMenuItems}
{/block}

{block content}
    {if $content}
        {$content|noescape}
    {else}
        {include '../../Common/views/navbar/_menuList.latte', items: $adminMenuItems}
    {/if}
{/block}