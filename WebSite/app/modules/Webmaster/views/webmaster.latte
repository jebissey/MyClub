{layout '../../Common/views/layout.latte'}

{* Single source of truth for the webmaster menu entries *}
{var $webmasterMenuItems = [
    ['page' => 'dbbrowser',         'href' => '/dbbrowser',          'icon' => '🗂️',  'label' => 'navbar.webmaster.dbbrowser'],
    ['page' => 'groups',            'href' => '/groups',             'icon' => '🧑‍🤝‍🧑',  'label' => 'navbar.webmaster.groups'],
    ['page' => 'registration',      'href' => '/registration',       'icon' => '🎟️',  'label' => 'navbar.webmaster.registration'],
    ['page' => 'notifications',     'href' => '/notifications',      'icon' => '🔔',  'label' => 'navbar.webmaster.notifications'],
    ['page' => 'sendEmails',        'href' => '/sendEmails',         'icon' => '📥',  'label' => 'navbar.webmaster.send_emails'],
    ['page' => 'turnstile',         'href' => '/turnstile',          'icon' => '🛡️',  'label' => 'navbar.webmaster.turnstile'],
    ['page' => 'helloasso',         'href' => '/helloasso',          'iconHtml' => '<i class="bi bi-recycle"></i>', 'text' => 'helloasso', 'label' => 'navbar.webmaster.helloasso'],
    ['page' => 'clubCustomization', 'href' => '/club-customization', 'icon' => '🏷️',  'label' => 'navbar.webmaster.club_customization'],
    ['page' => 'maintenance',       'href' => '/maintenance',        'icon' => '🚧',  'label' => 'navbar.webmaster.maintenance'],
    ['visible' => $isMyclubWebSite, 'page' => 'installations', 'href' => '/installations', 'icon' => '🌐', 'label' => 'navbar.webmaster.installations'],
]}

{block navbar}
    {include '../../Common/views/navbar/admin.latte', items: $webmasterMenuItems}
{/block}

{block content}
    {if isset($newVersion)}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <h3><a href="https://github.com/jebissey/MyClub/releases">{$newVersion}</a></h3>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {/if}

    {if $content}
        {$content|noescape}
    {else}
        {* Narrow screens only: the navbar is collapsed, so list the options here *}
        {include '../../Common/views/navbar/_menuList.latte', items: $webmasterMenuItems}
    {/if}
{/block}