{layout '../../Common/views/layout.latte'}

{var $webmasterMenuItems = [
    new app\modules\Common\valueObjects\MenuItem(
        page: 'dbbrowser',
        href: '/dbbrowser',
        icon: '🗂️',
        label: 'navbar.webmaster.dbbrowser'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'groups',
        href: '/groups',
        icon: '🧑‍🤝‍🧑',
        label: 'navbar.webmaster.groups'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'registration',
        href: '/registration',
        icon: '🎟️',
        label: 'navbar.webmaster.registration'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'notifications',
        href: '/notifications',
        icon: '🔔',
        label: 'navbar.webmaster.notifications'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'sendEmails',
        href: '/sendEmails',
        icon: '📥',
        label: 'navbar.webmaster.send_emails'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'turnstile',
        href: '/turnstile',
        icon: '🛡️',
        label: 'navbar.webmaster.turnstile'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'helloasso',
        href: '/helloasso',
        iconHtml: '<i class="bi bi-recycle"></i>',
        text: 'helloasso',
        label: 'navbar.webmaster.helloasso'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'clubCustomization',
        href: '/club-customization',
        icon: '🏷️',
        label: 'navbar.webmaster.club_customization'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'maintenance',
        href: '/maintenance',
        icon: '🚧',
        label: 'navbar.webmaster.maintenance'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'installations',
        href: '/installations',
        icon: '🌐',
        label: 'navbar.webmaster.installations',
        visible: $isMyclubWebSite
    ),
]}

{block navbar}
    {include '../../Common/views/navbar/admin.latte', items: $webmasterMenuItems}
{/block}

{block content}
    {if isset($newVersion)}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <h3><a href="https://github.com/jebissey/MyClub/releases">{$newVersion}</a></h3>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {/if}

    {if $content}
        {$content|noescape}
    {else}
        {include '../../Common/views/navbar/_menuList.latte', items: $webmasterMenuItems}
    {/if}
{/block}