{extends ../../Webmaster/views/admin.latte}

{block content}
<div class="container-fluid">
    <h2>{='backup.title'|translate}</h2>
    <p class="text-muted">{='backup.help'|translate}</p>

    <form id="backupForm" class="mb-4" data-url="/backupAll/download">
        <div class="mb-3">
            <label for="fileName" class="form-label">{='backup.form.file_name'|translate}</label>
            <div class="input-group" style="max-width: 32rem;">
                <input type="text" class="form-control" id="fileName" name="fileName"
                       value="{$defaultFileName}" maxlength="100" required>
                <span class="input-group-text">.zip</span>
            </div>
        </div>

        <button type="submit" class="btn btn-primary" id="backupBtn">{='backup.form.submit'|translate}</button>
        <div id="backupStatus" class="mt-3" role="status"></div>
    </form>

    <p class="small text-muted" id="backupFallbackNote" style="display: none;">
        {='backup.form.fallback_note'|translate}
    </p>

    <p class="mb-4">
        <strong>{='backup.last_backup'|translate} :</strong>
        {if $lastBackupDate !== null}{$lastBackupDate}{else}{='backup.last_backup.never'|translate}{/if}
    </p>

    <h3>{='backup.history.title'|translate}</h3>
    {if empty($lastBackups)}
        <p class="text-muted">{='backup.history.empty'|translate}</p>
    {else}
        <table class="table table-sm" style="max-width: 40rem;">
            <thead>
                <tr>
                    <th>{='backup.history.date'|translate}</th>
                    <th>{='backup.history.email'|translate}</th>
                </tr>
            </thead>
            <tbody>
                {foreach $lastBackups as $backup}
                    <tr>
                        <td>{$backup['date']}</td>
                        <td>{$backup['email']}</td>
                    </tr>
                {/foreach}
            </tbody>
        </table>
    {/if}    
</div>
{/block}

{block scripts}
<script>
    window.i18n ??= {};
    window.i18n['backup.form.submit'] = {='backup.form.submit'|translate};
    window.i18n['backup.form.submitting'] = {='backup.form.submitting'|translate};
    window.i18n['backup.js.done'] = {='backup.js.done'|translate};
    window.i18n['backup.js.error'] = {='backup.js.error'|translate};
    window.i18n['backup.js.file_type'] = {='backup.js.file_type'|translate};
</script>
<script type="module" src="{='/app/modules/Backup/js/backupForm.js'|version}"></script>
{/block}