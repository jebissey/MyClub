{layout '../../Common/views/layout.latte'}

{block navbar}
    {include '../../Common/views/navbar/_userLeft.latte'}
{/block}

{block content}

{include 'navTab.latte'}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">
        <i class="bi bi-calendar3 me-2 text-info"></i>
        {='loan.calendar.title'|translate}
    </h2>
    <div class="d-flex gap-3 align-items-center">
        <span class="d-flex align-items-center gap-1">
            <span class="badge bg-primary">&nbsp;&nbsp;</span>
            {='loan.calendar.loans'|translate}
        </span>
        <span class="d-flex align-items-center gap-1">
            <span class="badge" style="background:#fd7e14">&nbsp;&nbsp;</span>
            {='loan.calendar.reservations'|translate}
        </span>
        <span class="d-flex align-items-center gap-1">
            <span class="badge bg-success">&nbsp;&nbsp;</span>
            Rendu
        </span>
        <span class="d-flex align-items-center gap-1">
            <span class="badge bg-danger">&nbsp;&nbsp;</span>
            En retard
        </span>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div id="loanCalendar"></div>
    </div>
</div>

{* Popover de détail *}
<div class="modal fade" id="modalEventDetail" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title" id="detailTitle"></h6>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body small" id="detailBody"></div>
        </div>
    </div>
</div>
{/block}

{block scripts}
<script>
    window.i18n ??= {};
    window.i18n['loan.calendar.record.loan_date']           = {='loan.calendar.record.loan_date'|translate};
    window.i18n['loan.calendar.record.due_date']            = {='loan.calendar.record.due_date'|translate};
    window.i18n['loan.calendar.record.status']              = {='loan.calendar.record.status'|translate};
    window.i18n['loan.calendar.record.status.active']       = {='loan.calendar.record.status.active'|translate};
    window.i18n['loan.calendar.record.status.returned']     = {='loan.calendar.record.status.returned'|translate};
    window.i18n['loan.calendar.record.status.overdue']      = {='loan.calendar.record.status.overdue'|translate};
    window.i18n['loan.calendar.record.status.cancelled']    = {='loan.calendar.record.status.cancelled'|translate};
    window.i18n['loan.calendar.reservation.date']           = {='loan.calendar.reservation.date'|translate};
    window.i18n['loan.calendar.reservation.start']          = {='loan.calendar.reservation.start'|translate};
    window.i18n['loan.calendar.reservation.end']            = {='loan.calendar.reservation.end'|translate};
</script>
<script type="module" src="{='/app/modules/Loan/js/calendar.js'|version}"></script>
{/block}
