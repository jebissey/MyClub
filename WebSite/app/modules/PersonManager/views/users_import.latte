{extends $layout}

{block content}
    <div class="container-fluid">
        <h2>{='import.title'|translate}</h2>

        {if $results}
            <div class="container-fluid">
                {if $results['errors'] > 0}
                    <div class="alert alert-danger alert-dismissible">
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        <div class="alert alert-warning">
                            <h4>{='import.result.title'|translate}</h4>
                            <ul>
                                <li>{='import.result.created'|translate} {$results['created']}</li>
                                <li>{='import.result.updated'|translate} {$results['updated']}</li>
                                <li>{='import.result.deactivated'|translate} {$results['deactivated']}</li>
                                <li>{='import.result.errors'|translate} {$results['errors']}</li>
                            </ul>
                            <h4>{='import.result.errors_detail'|translate}</h4>
                            <ul>
                                {foreach $results['messages'] as $message}
                                    <li>{$message}</li>
                                {/foreach}
                            </ul>
                        </div>
                    </div>
                {else}
                    <div class="alert alert-success alert-dismissible">
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        <h4>{='import.result.success'|translate}</h4>
                        <ul>
                            <li>{='import.result.created'|translate} {$results['created']}</li>
                            <li>{='import.result.updated'|translate} {$results['updated']}</li>
                            <li>{='import.result.deactivated'|translate} {$results['deactivated']}</li>
                        </ul>
                        {if $results['messages']}
                            <hr>
                            <h5>{='import.result.details'|translate}</h5>
                            <ul>
                                {foreach $results['messages'] as $message}
                                    <li>{$message}</li>
                                {/foreach}
                            </ul>
                        {/if}
                    </div>
                {/if}
            </div>
        {/if}

        <form method="post" enctype="multipart/form-data" class="mb-4" id="importForm">
            <div class="mb-3">
                <label for="csvFile" class="form-label">{='import.form.csv_file'|translate}</label>
                <input type="file" class="form-control" id="csvFile" name="csvFile" accept=".csv" required>
            </div>

            <div id="headerRow" class="mb-3" style="display: none;">
                <label for="headerRowInput" class="form-label">{='import.form.header_row'|translate}</label>
                <input type="number" class="form-control w-auto" name="headerRow" id="headerRowInput"
                    value="{$importSettings['headerRow']}" min="1" required>
            </div>

            <div id="mappingSection" style="display: none;">
                <h4 class="mt-4">{='import.form.mapping_title'|translate}</h4>

                <div class="mb-3 d-flex align-items-end">
                    <label for="emailColumn" class="form-label me-2">{='import.form.email'|translate}</label>
                    <select class="form-select w-auto" id="emailColumn" name="emailColumn" required>
                        <option value="">{='import.form.select_column'|translate}</option>
                    </select>
                </div>

                <div class="mb-3 d-flex align-items-end">
                    <label for="firstNameColumn" class="form-label me-2">{='import.form.firstname'|translate}</label>
                    <select class="form-select w-auto" id="firstNameColumn" name="firstNameColumn" required>
                        <option value="">{='import.form.select_column'|translate}</option>
                    </select>
                </div>

                <div class="mb-3 d-flex align-items-end">
                    <label for="lastNameColumn" class="form-label me-2">{='import.form.lastname'|translate}</label>
                    <select class="form-select w-auto" id="lastNameColumn" name="lastNameColumn" required>
                        <option value="">{='import.form.select_column'|translate}</option>
                    </select>
                </div>

                <div class="mb-3 d-flex align-items-end">
                    <label for="phoneColumn" class="form-label me-2">{='import.form.phone'|translate}</label>
                    <select class="form-select w-auto" id="phoneColumn" name="phoneColumn">
                        <option value="">{='import.form.select_column'|translate}</option>
                    </select>
                </div>

                {if $customFields}
                    <h5 class="mt-4">{='import.form.custom_fields_title'|translate}</h5>
                    {foreach $customFields as $field}
                        <div class="mb-3 d-flex align-items-end">
                            <label for="customColumn_{$field['key']}" class="form-label me-2">{$field['label']}</label>
                            <select class="form-select w-auto" id="customColumn_{$field['key']}"
                                    name="customColumn[{$field['key']}]" data-custom-key="{$field['key']}">
                                <option value="">{='import.form.select_column'|translate}</option>
                            </select>
                        </div>
                    {/foreach}
                {/if}
            </div>
            <div id="emailColumnWarning" class="alert alert-warning py-1 px-2 mt-1" style="display: none;">
                {='import.form.email_header_warning'|translate}
            </div>

            <button type="submit" class="btn btn-primary" id="submitBtn" style="display: none;">{='import.form.submit'|translate}</button>
        </form>
    </div>
{/block}

{block scripts}
    <script>
        const importSettings = {$importSettings};
        window.i18n ??= {};
        window.i18n['import.form.select_column'] = {='import.form.select_column'|translate};
        window.i18n['import.form.submitting'] = {='import.form.submitting'|translate};
        window.i18n['import.js.invalid_extension'] = {='import.js.invalid_extension'|translate};
        window.i18n['import.js.invalid_type'] = {='import.js.invalid_type'|translate};
        window.i18n['import.js.file_too_large'] = {='import.js.file_too_large'|translate};
        window.i18n['import.js.unknown_error'] = {='import.js.unknown_error'|translate};
        window.i18n['import.js.read_error'] = {='import.js.read_error'|translate};
        window.i18n['import.js.column_option'] = {='import.js.column_option'|translate};
    </script>
    <script type="module" src="{='/app/modules/PersonManager/js/importForm.js'|version}"></script>
{/block}
