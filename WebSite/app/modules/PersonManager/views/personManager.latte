{layout '../../Common/views/layout.latte'}

{var $personManagerMenuItems = [
    new app\modules\Common\valueObjects\MenuItem(
        page: 'persons',
        href: '/persons',
        icon: '👥',
        label: 'navbar.person_manager.persons'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'groups',
        href: '/groups',
        icon: '👫',
        label: 'navbar.person_manager.groups'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'registration',
        href: '/registration',
        icon: '🎟️',
        label: 'navbar.person_manager.registration'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'import',
        href: '/import',
        icon: '📥',
        label: 'navbar.person_manager.import'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'export',
        href: '/export',
        icon: '📤',
        label: 'navbar.person_manager.export'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'membershipSettings',
        href: '/membership-settings',
        icon: '🤝',
        label: 'navbar.person_manager.membershipSettings'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'memberFields-settings',
        href: '/memberFields-settings',
        icon: '🔧',
        label: 'navbar.person_manager.settings'
    ),
]}

{block navbar}
    {include '../../Common/views/navbar/admin.latte', items: $personManagerMenuItems}
{/block}

{block content}
    {if $content}
        {$content|noescape}
    {else}
        {include '../../Common/views/navbar/_menuList.latte', items: $personManagerMenuItems}
    {/if}
{/block}