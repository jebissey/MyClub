{extends $layout}

{block title}{='person_manager.group.create.title'|translate}{/block}

{block content}
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title h5 m-0">{='person_manager.group.create.title'|translate}</h2>
                </div>
                <div class="card-body">
                    {if isset($error)}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        {$error}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{='common.close'|translate}"></button>
                    </div>
                    {/if}

                    <form method="POST">
                        <div class="mb-3">
                            <label for="name" class="form-label">{='person_manager.group.create.name'|translate}</label>
                            <input type="text" class="form-control {if isset($error)}is-invalid{/if}"
                                id="name" name="name" required>
                            <div class="invalid-feedback">{='person_manager.group.name_required'|translate}</div>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="selfRegistration"
                                name="selfRegistration" value="1">
                            <label class="form-check-label" for="selfRegistration">{='person_manager.group.create.self_registration'|translate}</label>
                        </div>
                        {if $isWebmaster}
                        <div class="mb-3">
                            <label class="form-label">{='person_manager.group.create.authorizations'|translate}</label>
                            {if $availableAuthorizations}
                                {foreach $availableAuthorizations as $authorization}
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                            id="auth_{$authorization->Id}"
                                            name="authorizations[]"
                                            value="{$authorization->Id}">
                                        <label class="form-check-label" for="auth_{$authorization->Id}">
                                        {$authorization->Name}
                                        </label>
                                    </div>
                                {/foreach}
                            {else}
                                <p>{='person_manager.group.create.no_authorization'|translate}</p>
                            {/if}
                        </div>
                        {/if}
                        <div class="d-flex justify-content-between">
                            <a href="/groups" class="btn btn-secondary">{='cancel'|translate}</a>
                            <button type="submit" class="btn btn-primary">{='save'|translate}</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{/block}

{block scripts}
<script>
    window.i18n ??= {};
    window.i18n['person_manager.group.name_required'] = {='person_manager.group.name_required'|translate};
</script>
<script type="module" src="{='/app/modules/PersonManager/js/groupForm.js'|version}"></script>
{/block}
