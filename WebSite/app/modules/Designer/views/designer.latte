{layout '../../Common/views/layout.latte'}

{var $designerMenuItems = [
    new app\modules\Common\valueObjects\MenuItem(
        page: 'eventTypes',
        href: '/eventTypes',
        icon: '🗓️',
        label: 'navbar.designer.event_types',
        visible: $isEventDesigner
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'needs',
        href: '/needs',
        icon: '📋',
        label: 'navbar.designer.needs',
        visible: $isEventDesigner
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'exercises',
        href: '/exercises',
        icon: '🏋️',
        label: 'navbar.designer.exercise',
        visible: $isExerciseDesigner
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'settings',
        href: '/settings',
        icon: '🔧',
        label: 'navbar.designer.settings',
        visible: $isHomeDesigner
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'designs',
        href: '/designs',
        icon: '🧠',
        label: 'navbar.designer.designs',
        visible: $isHomeDesigner
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'kanban',
        href: '/kanban',
        icon: '🟨',
        label: 'navbar.designer.kanban',
        visible: $isKanbanDesigner
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'menu',
        href: '/menu',
        icon: '📑',
        label: 'navbar.designer.menu',
        visible: $isMenuDesigner
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'loan',
        href: '/loan',
        icon: '🔁',
        label: 'navbar.designer.loan',
        visible: $isLoanDesigner
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'translator',
        href: '/translator',
        icon: '🌍',
        label: 'navbar.designer.translator',
        visible: $isTranslator
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'routes',
        href: '/routes',
        icon: '🪧',
        label: 'navbar.designer.routes',
        visible: $isAnybody
    ),
]}

{block navbar}
    {include '../../Common/views/navbar/admin.latte', items: $designerMenuItems}
{/block}

{block content}
    {if $content}
        {$content|noescape}
    {else}
        {include '../../Common/views/navbar/_menuList.latte', items: $designerMenuItems}
    {/if}
{/block}