{varType list<\app\modules\Common\valueObjects\TableRow> $items}
{varType list<string|array{name: string, label: string, type?: string, options?: array<mixed>, optionValue?: string, optionLabel?: string, placeholder?: string, autosubmit?: bool}> $filters}
{varType string $resetUrl}
{varType array<string, string> $filterValues}
{varType int $currentPage}
{varType int $totalPages}
{varType array<string, string> $extraParams}
{varType list<array{field: string, label: string}> $columns}
{varType string $table}
{varType ?array{url: string, label: string, alignment?: string} $createButton}
{varType ?array{id: string, title: string, contentId: string} $modal}
{varType list<array{type: string, label: string, class: string, url?: string, confirm?: string, onClick?: string}> $actions}

{default $actions = []}
{default $createButton = null}
{default $modal = null}
{default $table = ''}
{default $extraParams = []}

<div class="container-fluid">
    {include 'FilterForm.latte',
        filters:      $filters,
        action:       $resetUrl,
        resetUrl:     $resetUrl,
        filterValues: $filterValues,
        extraParams:  $extraParams,
        currentPage:  $currentPage,
        totalPages:   $totalPages,
        pageParam:    'tablePage'}

    {if $createButton !== null}
        {var $alignment = \app\helpers\To::str($createButton['alignment'] ?? '')}
        {var $alignmentClass = $alignment !== '' ? 'd-flex justify-content-' . $alignment : ''}
        <div class="{$alignmentClass}">
            <a href="{$createButton['url']}" class="btn btn-primary mb-3 mt-3"><i class="{$createButton['label']}"></i></a>
        </div>
    {/if}

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    {foreach $columns as $column}
                        <th>{$column['label']}</th>
                    {/foreach}
                    {if $actions !== []}
                        <th>{='common.table.actions'|translate}</th>
                    {/if}
                </tr>
            </thead>
            <tbody>
                {foreach $items as $item}
                    <tr>
                        {foreach $columns as $column}
                            {var $v = $item->cells[$column['field']] ?? null}
                            <td title="{$v}">
                                {if $v !== null}
                                    {var $s = (string) $v}
                                    {if mb_strlen($s) > 400}
                                        {$s|truncate:50}
                                    {else}
                                        {$s}
                                    {/if}
                                {/if}
                            </td>
                        {/foreach}
                        {if $actions !== []}
                            <td>
                                {foreach $actions as $action}
                                    {if $action['type'] === 'link'}
                                        {var $url = \app\helpers\To::str($action['url'] ?? '')}
                                        {var $confirm = \app\helpers\To::str($action['confirm'] ?? '')}
                                        {var $firstCell = \app\helpers\To::str($item->cells[$columns[0]['field']] ?? '')}
                                        <a href="{str_replace('{table}', $table, str_replace('{id}', (string) $item->id, $url))}" class="btn btn-sm {$action['class']}"
                                        {if $confirm !== ''}
                                            onclick="return confirm({$confirm . ' ' . $firstCell})"
                                        {/if}>
                                            <i class="{$action['label']}"></i>
                                        </a>
                                    {elseif $action['type'] === 'button'}
                                        {var $onClick = \app\helpers\To::str($action['onClick'] ?? '')}
                                        <button class="btn btn-sm {$action['class']}"
                                                onclick="{str_replace('{table}', $table, str_replace('{id}', (string) $item->id, $onClick)) | noescape}">
                                            <i class="{$action['label']}"></i>
                                        </button>
                                    {/if}
                                {/foreach}
                            </td>
                        {/if}
                    </tr>
                {/foreach}
            </tbody>
        </table>
    </div>
</div>

{if $modal !== null}
<div class="modal fade" id="{$modal['id']}" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{$modal['title']}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="{$modal['contentId']}">
            </div>
        </div>
    </div>
</div>
{/if}