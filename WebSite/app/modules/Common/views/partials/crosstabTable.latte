{* Expected params: $crosstabData, $totalLabels *}
{define cell $count, $count2}
    {if $count > 0}
        <div>{$count}</div>
        {if $count2 > 0}<small class="text-secondary">{$count2}</small>{/if}
    {else}
        <span class="text-muted">-</span>
    {/if}
{/define}

<div class="table-responsive">
    <table class="table table-bordered table-hover table-striped">
        <thead>
            <tr>
                <th rowspan="2" class="align-middle"><h1>{$crosstabData['rowsTitle']}</h1></th>
                <th colspan="{count($crosstabData['columns'])}" class="text-center"><h2>{$crosstabData['columnsTitle']}</h2></th>
                <th rowspan="2" class="align-middle text-center bg-primary text-white fs-5">{='common.crosstab.total'|translate}</th>
            </tr>
            <tr>
                {foreach $crosstabData['columns'] as $column}
                    <th class="text-center">{$column}</th>
                {/foreach}
            </tr>
        </thead>

        <tbody>
            {foreach $crosstabData['rows'] as $rowLabel => $rowValues}
                {var $rowCount = 0}
                {var $rowCount2 = 0}
                {foreach $rowValues as $v}
                    {do $rowCount += $v['count']}
                    {do $rowCount2 += $v['count2']}
                {/foreach}
                <tr>
                    <td><strong>{$rowLabel}</strong></td>
                    {foreach $crosstabData['columns'] as $column}
                        {var $value = $rowValues[$column] ?? ['count' => 0, 'count2' => 0]}
                        <td class="text-center">{include cell $value['count'], $value['count2']}</td>
                    {/foreach}
                    <td class="text-center fw-bold bg-light">{include cell $rowCount, $rowCount2}</td>
                </tr>
            {/foreach}
        </tbody>

        <tfoot>
            {var $grandCount = 0}
            {var $grandCount2 = 0}
            <tr class="fs-5 bg-primary text-white">
                <td>
                    <strong>{='common.crosstab.total'|translate}</strong>
                    <div>{$totalLabels[0]}</div>
                    {if $totalLabels[1]}<small class="text-secondary">{$totalLabels[1]}</small>{/if}
                </td>
                {foreach $crosstabData['columns'] as $column}
                    {var $colCount = 0}
                    {var $colCount2 = 0}
                    {foreach $crosstabData['rows'] as $rowValues}
                        {do $colCount += ($rowValues[$column]['count'] ?? 0)}
                        {do $colCount2 += ($rowValues[$column]['count2'] ?? 0)}
                    {/foreach}
                    {do $grandCount += $colCount}
                    {do $grandCount2 += $colCount2}
                    <td class="text-center fw-bold">{include cell $colCount, $colCount2}</td>
                {/foreach}
                <td class="text-center fw-bold bg-light text-dark">{include cell $grandCount, $grandCount2}</td>
            </tr>
        </tfoot>
    </table>
</div>