{varType list<app\modules\Common\valueObjects\MenuItem> $items}

<div class="list-group d-lg-none mt-3">
    {foreach $items as $item}
        {if $item->visible}
            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3"
               href="{$item->href}">
                <span class="fs-3">
                    {if $item->iconHtml !== null}
                        {$item->iconHtml|noescape}
                    {else}
                        {$item->icon}
                    {/if}
                </span>
                <span>{$item->label|translate}</span>
            </a>
        {/if}
    {/foreach}
</div>