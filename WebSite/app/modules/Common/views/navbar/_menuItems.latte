{varType list<app\modules\Common\valueObjects\MenuItem> $items}
{foreach $items as $item}
    {if $item->visible}
        <li class="nav-item">
            <a class="nav-link {if $item->page !== null && $page === $item->page}active{/if}"
                href="{$item->href}"
                data-bs-toggle="tooltip"
                data-bs-placement="bottom"
                title="{$item->label|translate}">
                {if $item->iconHtml !== null}
                <h3>{$item->iconHtml|noescape}{$item->text}</h3>
                {else}
                <h2>{$item->icon}</h2>
                {/if}
            </a>
        </li>
    {/if}
{/foreach}