{varType string $name}
{varType string $label}
{varType string $type}
{varType string $value}
{varType array<string|array<string, mixed>|object> $options}
{varType string $optionValue}
{varType string $optionLabel}
{varType string $placeholder}
{varType bool $autosubmit}

{var $toStr = fn($v): string => is_scalar($v) || $v === null ? (string) $v : ''}

<label for="{$name}" class="form-label">{$label}</label>

{if $type === 'select'}
    <select class="form-select" id="{$name}" name="{$name}"{if $autosubmit} onchange="this.form.submit()"{/if}>
        {if $placeholder !== ''}
            <option value="">{$placeholder}</option>
        {/if}
        {foreach $options as $optKey => $optItem}
            {if is_object($optItem)}
                {var $optValue = $toStr($optItem->$optionValue ?? null)}
                <option value="{$optValue}" {if $value === $optValue}selected{/if}>
                    {$toStr($optItem->$optionLabel ?? null)}
                </option>
            {elseif is_array($optItem)}
                {var $optValue = $toStr($optItem[$optionValue] ?? null)}
                <option value="{$optValue}" {if $value === $optValue}selected{/if}>
                    {$toStr($optItem[$optionLabel] ?? null)}
                </option>
            {else}
                {* Associative array of simple values: ['all' => 'Everything', …] *}
                {var $optValue = $toStr($optKey)}
                <option value="{$optValue}" {if $value === $optValue}selected{/if}>
                    {$toStr($optItem)}
                </option>
            {/if}
        {/foreach}
    </select>
{else}
    <input type="text" class="form-control" id="{$name}" name="{$name}" value="{$value}">
{/if}