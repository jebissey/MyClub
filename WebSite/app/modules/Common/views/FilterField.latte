{* Params, all provided by FilterForm.latte:
   $name, $label, $type, $value, $options, $optionValue, $optionLabel, $placeholder, $autosubmit *}
{var $toStr = fn($v): string => is_scalar($v) ? (string) $v : ''}

<label for="{$name}" class="form-label">{$label}</label>

{if $type === 'select'}
    <select class="form-select" id="{$name}" name="{$name}"{if $autosubmit} onchange="this.form.submit()"{/if}>
        {if $placeholder !== ''}
            <option value="">{$placeholder}</option>
        {/if}
        {foreach $options as $optKey => $optItem}
            {if is_object($optItem)}
                {var $optValue = $toStr($optItem->$optionValue)}
                <option value="{$optValue}" {if $value === $optValue}selected{/if}>
                    {$optItem->$optionLabel}
                </option>
            {elseif is_array($optItem)}
                {var $optValue = $toStr($optItem[$optionValue] ?? null)}
                <option value="{$optValue}" {if $value === $optValue}selected{/if}>
                    {$optItem[$optionLabel] ?? ''}
                </option>
            {else}
                {* simple associative array: ['all' => 'Everything', …] *}
                <option value="{$optKey}" {if $value === (string) $optKey}selected{/if}>
                    {$optItem}
                </option>
            {/if}
        {/foreach}
    </select>
{else}
    <input type="text" class="form-control" id="{$name}" name="{$name}" value="{$value}">
{/if}