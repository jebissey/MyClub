{layout '../../Common/views/layout.latte'}

{var $visitorInsightsMenuItems = [
    new app\modules\Common\valueObjects\MenuItem(
        page: 'referents',
        href: '/referents',
        icon: '☁️',
        label: 'navbar.visitor_insights.referents'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'topPages',
        href: '/topPages',
        icon: '📈',
        label: 'navbar.visitor_insights.top_pages'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'crossTab',
        href: '/crossTab',
        icon: '🧮',
        label: 'navbar.visitor_insights.crosstab'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'logs',
        href: '/logs',
        icon: '📋',
        label: 'navbar.visitor_insights.logs'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'visitorsGraf',
        href: '/visitorsGraf',
        icon: '📊',
        label: 'navbar.visitor_insights.visitors'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'analytics',
        href: '/analytics',
        icon: '🥧',
        label: 'navbar.visitor_insights.analytics'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'lastVisits',
        href: '/lastVisits',
        icon: '👁️',
        label: 'navbar.visitor_insights.last_visits'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'membersAlerts',
        href: '/membersAlerts',
        icon: '📩',
        label: 'navbar.visitor_insights.members_alerts'
    ),
]}

{block navbar}
    {include '../../Common/views/navbar/admin.latte', items: $visitorInsightsMenuItems}
{/block}

{block content}
    {if $content}
        {$content|noescape}
    {else}
        {include '../../Common/views/navbar/_menuList.latte', items: $visitorInsightsMenuItems}
    {/if}
{/block}