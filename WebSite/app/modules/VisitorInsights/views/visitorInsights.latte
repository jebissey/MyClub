{layout '../../Common/views/layout.latte'}

{* Single source of truth for the visitor insights menu entries *}
{var $visitorInsightsMenuItems = [
    ['page' => 'referents',     'href' => '/referents',     'icon' => '☁️', 'label' => 'navbar.visitor_insights.referents'],
    ['page' => 'topPages',      'href' => '/topPages',      'icon' => '📈', 'label' => 'navbar.visitor_insights.top_pages'],
    ['page' => 'crossTab',      'href' => '/crossTab',      'icon' => '🧮', 'label' => 'navbar.visitor_insights.crosstab'],
    ['page' => 'logs',          'href' => '/logs',          'icon' => '📋', 'label' => 'navbar.visitor_insights.logs'],
    ['page' => 'visitorsGraf',  'href' => '/visitorsGraf',  'icon' => '📊', 'label' => 'navbar.visitor_insights.visitors'],
    ['page' => 'analytics',     'href' => '/analytics',     'icon' => '🥧', 'label' => 'navbar.visitor_insights.analytics'],
    ['page' => 'lastVisits',    'href' => '/lastVisits',    'icon' => '👁️', 'label' => 'navbar.visitor_insights.last_visits'],
    ['page' => 'membersAlerts', 'href' => '/membersAlerts', 'icon' => '📩', 'label' => 'navbar.visitor_insights.members_alerts'],
]}

{block navbar}
    {include 'navbar/visitorInsights.latte', items: $visitorInsightsMenuItems}
{/block}

{block content}
    {if $content}
        {$content|noescape}
    {else}
        {* Narrow screens only: the navbar is collapsed, so list the options here *}
        {include '../../Common/views/navbar/_menuList.latte', items: $visitorInsightsMenuItems}
    {/if}
{/block}