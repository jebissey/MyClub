{extends 'redactor.latte'}

{block content}
    <div class="container-fluid">
        {if $form !== null}
        <h1>{='article.survey.add.title_edit'|translate} {$article->title}</h1>
        {else}
        <h1>{='article.survey.add.title_new'|translate} {$article->title}</h1>
        {/if}
        <form action="/survey/create" method="POST">
            <input type="hidden" name="article_id" value="{$article->id}">
            {if $form !== null}
            <div class="alert alert-danger" role="alert">
                <p>{='article.survey.add.edit_warning'|translate}</p>
            </div>
            {/if}
            <div class="mb-3">
                <label for="question" class="form-label">{='article.survey.add.question'|translate}</label>
                <input type="text" class="form-control" id="question" name="question" value="{$form?->question}" required>
            </div>

            <div id="options-container">
                <div class="mb-3">
                    <label class="form-label">{='article.survey.add.options'|translate}</label>
                    {if $form !== null}
                        {foreach $form->options as $optionText}
                        <div class="d-flex mb-2">
                            <input type="text" class="form-control me-2" name="options[]" value="{$optionText}" required>
                            <button type="button" class="btn btn-danger remove-option" {if count($form->options) <= 2}disabled{/if}>-</button>
                        </div>
                        {/foreach}
                    {else}
                        <div class="d-flex mb-2">
                            <input type="text" class="form-control me-2" name="options[]" required>
                            <button type="button" class="btn btn-danger remove-option" disabled>-</button>
                        </div>
                        <div class="d-flex mb-2">
                            <input type="text" class="form-control me-2" name="options[]" required>
                            <button type="button" class="btn btn-danger remove-option" disabled>-</button>
                        </div>
                    {/if}
                </div>
                <button type="button" id="add-option" class="btn btn-secondary mb-3">{='article.survey.add.add_option'|translate}</button>
                <div class="mb-3">
                    <label for="dateInput" class="form-label">{='article.closable_form.closing_date'|translate}</label>
                    <input type="date" class="form-control w-auto" id="dateInput" name="closingDate" value="{$form?->closingDate}" required>
                </div>
                <div class="mb-3">
                    <label for="visibility" class="form-label">{='article.closable_form.visibility'|translate}</label>
                    <select class="form-select w-auto" id="visibility" name="visibility" required>
                        {foreach $visibilityOptions as $value => $label}
                        <option value="{$value}" {if $form !== null && $form->visibility === $value}selected{/if}>{$label}</option>
                        {/foreach}
                    </select>
                </div>
            </div>

            <div class="mb-3">
                {if $form !== null}
                <button type="submit" class="btn btn-primary">{='article.survey.add.submit_edit'|translate}</button>
                {else}
                <button type="submit" class="btn btn-primary">{='article.survey.add.submit_new'|translate}</button>
                {/if}
                <a href="/article/{$article->id}" class="btn btn-secondary">{='article.closable_form.cancel'|translate}</a>
            </div>
        </form>
    </div>
{/block}

{block scripts}
<script>
    Object.assign(window.i18n, {
        spotlightDateRequired: {='article.index.spotlight_date_required'|translate}
    });
</script>
<script src="{='/app/modules/Article/js/articles.js'|version}"></script>
{/block}