{extends 'redactor.latte'}

{block content}
<div class="container-fluid">
    {if $form !== null}
        <h1>{='order.add.title.edit'|translate} {$article->title}</h1>
    {else}
        <h1>{='order.add.title.create'|translate} {$article->title}</h1>
    {/if}

    <form action="/order/create" method="POST">
        <input type="hidden" name="article_id" value="{$article->id}">

        {if $form !== null}
            <div class="alert alert-danger" role="alert">
                <p>{='order.add.warning'|translate}</p>
            </div>
        {/if}

        <div class="mb-3">
            <label for="question" class="form-label">
                {='order.add.description'|translate}
            </label>
            <input
                type="text"
                class="form-control"
                id="question"
                name="question"
                value="{$form->question ?? ''}"
                required
            >
        </div>

        <div id="options-container">
            <div class="mb-3">
                <label class="form-label">
                    {='order.add.available_items'|translate}
                </label>

                {var $options = $form->options ?? ['', '']}

                {foreach $options as $option}
                    <div class="d-flex mb-2">
                        <input
                            type="text"
                            class="form-control me-2"
                            name="options[]"
                            value="{$option}"
                            required
                        >
                        <button
                            type="button"
                            class="btn btn-danger remove-option"
                            {if count($options) <= 2}disabled{/if}
                        >-</button>
                    </div>
                {/foreach}
            </div>

            <button
                type="button"
                id="add-option"
                class="btn btn-secondary mb-3"
            >{='order.add.add_item'|translate}</button>

            <div class="mb-3">
                <label for="dateInput" class="form-label">
                    {='order.add.closing_date'|translate}
                </label>
                <input
                    type="date"
                    class="form-control w-auto"
                    id="dateInput"
                    name="closingDate"
                    value="{$form->closingDate ?? ''}"
                    required
                >
            </div>

            <div class="mb-3">
                <label for="visibility" class="form-label">
                    {='order.add.visibility'|translate}
                </label>
                <select
                    class="form-select w-auto"
                    id="visibility"
                    name="visibility"
                    required
                >
                    {foreach $visibilityOptions as $value => $label}
                        <option
                            value="{$value}"
                            n:attr="selected => $form?->visibility === $value"
                        >{$label}</option>
                    {/foreach}
                </select>
            </div>
        </div>

        <div class="mb-3">
            {if $form !== null}
                <button type="submit" class="btn btn-primary">
                    {='order.add.button.edit'|translate}
                </button>
            {else}
                <button type="submit" class="btn btn-primary">
                    {='order.add.button.create'|translate}
                </button>
            {/if}

            <a href="/article/{$article->id}" class="btn btn-secondary">
                {='order.add.button.cancel'|translate}
            </a>
        </div>
    </form>
</div>
{/block}

{block scripts}
<script src="{='/app/modules/Article/js/addRemoveLine.js'|version}"></script>
{/block}