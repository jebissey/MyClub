{layout '../../Common/views/layout.latte'}

{var $redactorMenuItems = [
    new app\modules\Common\valueObjects\MenuItem(
        page: 'articles',
        href: '/articles',
        icon: '📰',
        label: 'navbar.redactor.articles'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'articles',
        href: '/articles/public',
        icon: '⚖️',
        label: 'navbar.redactor.public_articles',
        visible: $isEditor
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'media',
        href: '/media/list',
        icon: '📂',
        label: 'navbar.redactor.media'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'topArticles',
        href: '/topArticles',
        icon: '📈',
        label: 'navbar.redactor.top_articles'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'crossTab',
        href: '/articles/crossTab',
        icon: '🧮',
        label: 'navbar.redactor.crossTab'
    ),
]}

{block navbar}
    {include '../../Common/views/navbar/admin.latte', items: $redactorMenuItems}
{/block}

{block content}
    {if $content}
        {$content|noescape}
    {else}
        {include '../../Common/views/navbar/_menuList.latte', items: $redactorMenuItems}
    {/if}
{/block}