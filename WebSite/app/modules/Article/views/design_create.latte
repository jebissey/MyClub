{extends '../../Designer/views/designer.latte'}

{block content}
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="card">
                    <div class="card-header">
                        <h2>{='design.create.title'|translate}</h2>
                    </div>
                    <div class="card-body">
                        <form action="/design/save" method="post">
                            <div class="mb-3">
                                <label for="name" class="form-label">{='design.create.name'|translate}</label>
                                <input type="text" class="form-control" id="name" name="name" required>
                            </div>

                            <div class="mb-3">
                                <label for="detail" class="form-label">{='design.create.detail'|translate}</label>
                                <textarea class="form-control" id="detail" name="detail" rows="3"></textarea>
                            </div>

                            <div class="mb-3">
                                <label for="navbar" class="form-label">{='design.create.navbar'|translate}</label>
                                <select class="form-select" id="navbar" name="navbar" required>
                                    <option value="">{='design.create.navbar.choose'|translate}</option>
                                    <option value="article">{='design.create.navbar.article'|translate}</option>
                                    <option value="award">{='design.create.navbar.award'|translate}</option>
                                    <option value="getEmails">{='design.create.navbar.get_emails'|translate}</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">{='design.create.audience'|translate}</label>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="visibility" id="visibilityAll" value="all">
                                    <label class="form-check-label" for="visibilityAll">
                                        {='design.create.audience.all'|translate}
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="visibility" id="visibilityMembers" value="members" checked>
                                    <label class="form-check-label" for="visibilityMembers">
                                        {='design.create.audience.members'|translate}
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="visibility" id="visibilityGroup" value="group">
                                    <label class="form-check-label" for="visibilityGroup">
                                        {='design.create.audience.group'|translate}
                                    </label>
                                </div>

                                <div class="mt-2" id="groupSelection" style="display: none;">
                                    <select class="form-select" id="idGroup" name="idGroup">
                                        <option value="">{='design.create.group.choose'|translate}</option>
                                        {foreach $groups as $group}
                                            <option value="{$group->id}">{$group->name}</option>
                                        {/foreach}
                                    </select>
                                </div>
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <a href="/designs" class="btn btn-secondary me-md-2">{='design.create.cancel'|translate}</a>
                                <button type="submit" class="btn btn-primary">{='design.create.save'|translate}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{/block}

{block scripts}
    <script src="{='/app/modules/Article/js/designs/create.js'|version}"></script>
{/block}