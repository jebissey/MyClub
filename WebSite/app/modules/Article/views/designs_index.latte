{extends '../../Designer/views/designer.latte'}

{block content}
    <div class="container-fluid mt-4 mb-3 d-flex justify-content-between align-items-center">
        <h1>{='design.index.title'|translate}</h1>
        <a href="/design/create" class="btn btn-primary">
            <i class="bi bi-plus"></i> {='design.index.add'|translate}
        </a>
    </div>

    <div class="container-fluid mb-4">
        <div class="card shadow-sm w-100">
            <div class="card-header bg-info">
                {='design.index.proposal_title'|translate}
            </div>
            <div class="card-body">
                <p class="card-text">
                    {='design.index.proposal_intro'|translate}
                </p>
                <ul class="list-group list-group-flush mb-3">
                    <li class="list-group-item">
                        <strong>{='design.index.name_label'|translate}</strong> {='design.index.name_help'|translate}
                    </li>
                    <li class="list-group-item">
                        <strong>{='design.index.detail_label'|translate}</strong> {='design.index.detail_help'|translate}
                    </li>
                    <li class="list-group-item">
                        <strong>{='design.index.audience_label'|translate}</strong> {='design.index.audience_help'|translate}
                    </li>
                </ul>
                <p class="card-text">
                    {='design.index.review_notice'|translate}
                </p>
                <p class="mb-0">
                    {='design.index.thanks'|translate}
                </p>
            </div>
        </div>
    </div>

    <div class="container-fluid mb-4">
        <div class="table-responsive">
            <table class="table table-hover w-100">
                <thead>
                    <tr>
                        <th>{='design.index.col_designer'|translate}</th>
                        <th>{='design.index.col_name'|translate}</th>
                        <th>{='design.index.col_navbar'|translate}</th>
                        <th>{='design.index.col_status'|translate}</th>
                        <th>{='design.index.col_votes'|translate}</th>
                        <th>{='design.index.col_all'|translate}</th>
                        <th>{='design.index.col_members'|translate}</th>
                        {foreach $groups as $group}
                            <th>{$group->name}</th>
                        {/foreach}
                    </tr>
                </thead>
                <tbody>
                    {foreach $designs as $design}
                        <tr class="design-row"
                            data-id="{$design->id}"
                            data-name="{$design->name}"
                            data-detail="{$design->detail}">

                            <td>{$design->nameOfDesigner}</td>
                            <td data-bs-toggle="tooltip" data-bs-placement="top" title="{$design->detail}">
                                {$design->name}
                            </td>
                            <td>{$design->navBar}</td>
                            <td>
                                {if $design->status === 'UnderReview'}
                                    <h4>⏳</h4>
                                {elseif $design->status === 'Approved'}
                                    <h4>✅</h4>
                                {elseif $design->status === 'Rejected'}
                                    <h4>❌</h4>
                                {/if}
                            </td>
                            <td>{$design->votes}</td>
                            <td class="text-center">
                                {if $design->idGroup === null && $design->onlyForMembers === 0}
                                    <h4>✅</h4>
                                {/if}
                            </td>
                            <td class="text-center">
                                {if $design->idGroup === null && $design->onlyForMembers === 1}
                                    <h4>✅</h4>
                                {/if}
                            </td>
                            {foreach $groups as $group}
                                <td class="text-center">
                                    {if $design->idGroup === $group->id}
                                        <h4>✅</h4>
                                    {/if}
                                </td>
                            {/foreach}
                        </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="voteModal" tabindex="-1" aria-labelledby="voteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="voteModalLabel">{='design.index.vote_title'|translate}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{='design.index.close'|translate}"></button>
                </div>
                <div class="modal-body">
                    <h4 id="design-name"></h4>
                    <p id="design-detail"></p>

                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="voteOption" id="voteUp" value="voteUp">
                        <label class="form-check-label" for="voteUp">👍 {='design.index.vote_for'|translate}</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="voteOption" id="voteDown" value="voteDown">
                        <label class="form-check-label" for="voteDown">👎 {='design.index.vote_against'|translate}</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="voteOption" id="voteNeutral" value="voteNeutral">
                        <label class="form-check-label" for="voteNeutral">🤔 {='design.index.vote_neutral'|translate}</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{='cancel'|translate}</button>
                    <button type="button" class="btn btn-primary" id="submit-vote">{='design.index.vote_submit'|translate}</button>
                </div>
            </div>
        </div>
    </div>
{/block}

{block scripts}
<script>
    const userVotes = {$userVotes};
</script>
<script src="{='/app/modules/Article/js/designs/index.js'|version}"></script>
{/block}