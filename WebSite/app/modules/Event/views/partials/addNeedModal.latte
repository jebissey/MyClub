<div class="modal fade" id="addNeedModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="needModalTitle">{='event.needs.modal.need.add'|translate}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{='common.close'|translate}"></button>
            </div>
            <div class="modal-body">
                <form id="needForm">
                    <input type="hidden" id="needId" name="id">
                    <div class="mb-3">
                        <label for="needType" class="form-label">{='event.needs.column.type'|translate}</label>
                        <select class="form-select" id="needType" name="idNeedType" required>
                            <option value="">{='event.needs.form.select_type'|translate}</option>
                            {foreach $needTypes as $type}
                                <option value="{$type->id}">{$type->name}</option>
                            {/foreach}
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="needLabel" class="form-label">{='event.needs.column.label'|translate}</label>
                        <input type="text" class="form-control" id="needLabel" name="label" required>
                    </div>
                    <div class="mb-3">
                        <label for="needName" class="form-label">{='event.needs.column.name'|translate}</label>
                        <input type="text" class="form-control" id="needName" name="name" required>
                    </div>
                    <div class="mb-3">
                        <label for="needParticipantDependent" class="form-label">{='event.needs.form.participant_dependent'|translate}</label>
                        <input class="form-check-input" type="checkbox" id="needParticipantDependent" name="participantDependent" value="1">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{='common.cancel'|translate}</button>
                <button type="button" class="btn btn-primary" id="saveNeed">{='common.save'|translate}</button>
            </div>
        </div>
    </div>
</div>