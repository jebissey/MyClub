<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{='common.delete_confirm.title'|translate}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{='common.close'|translate}"></button>
            </div>
            <div class="modal-body">
                <p id="deleteConfirmMessage">{='event.needs.delete.default_message'|translate}</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{='common.cancel'|translate}</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">{='common.delete'|translate}</button>
            </div>
        </div>
    </div>
</div>