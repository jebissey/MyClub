{layout '../../Common/views/layout.latte'}

{var $eventManagerMenuItems = [
    new app\modules\Common\valueObjects\MenuItem(
        page: 'weekEvents',
        href: '/weekEvents',
        icon: '🗓️',
        label: 'navbar.event_manager.week_events'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'nextEvents',
        href: '/nextEvents',
        icon: '📅',
        label: 'navbar.event_manager.next_events'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'guest',
        href: '/events/guest',
        icon: '📩',
        label: 'navbar.event_manager.guest_invitation'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'emails',
        href: '/emails',
        icon: '📧',
        label: 'navbar.event_manager.emails'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'crossTab',
        href: '/events/crossTab',
        icon: '🧮',
        label: 'navbar.event_manager.crosstab'
    ),
    new app\modules\Common\valueObjects\MenuItem(
        page: 'availabilities',
        href: '/availabilities',
        icon: '🕒',
        label: 'navbar.event_manager.availabilities'
    ),
]}

{block navbar}
    {include '../../Common/views/navbar/admin.latte', items: $eventManagerMenuItems}
{/block}

{block content}
    {if $content}
        {$content|noescape}
    {else}
        {include '../../Common/views/navbar/_menuList.latte', items: $eventManagerMenuItems}
    {/if}
{/block}