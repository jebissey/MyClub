{extends $layout}

{block content}
<div class="container-fluid">
    <h1 class="my-4">{='availability.stats.title'|translate}</h1>

    {* Barre de progression : % de membres ayant renseigné *}
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">{='availability.filled.title'|translate}</h5>
        </div>
        <div class="card-body">
            <div class="progress" style="height: 28px;">
                <div class="progress-bar bg-primary"
                     role="progressbar"
                     style="width: {$stats['percentageFilled']|noescape}%;"
                     aria-valuenow="{$stats['percentageFilled']}"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    {$stats['percentageFilled']}%
                </div>
            </div>
            <small class="text-muted mt-2 d-block">
                {$stats['withAvailability']} / {$stats['totalActive']}
                {='availability.filled.members'|translate}
            </small>
        </div>
    </div>

    {* Graphique empilé *}
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">{='availability.by_slot.title'|translate}</h5>
        </div>
        <div class="card-body">
            <div style="position: relative; height: 360px; width: 100%;">
                <canvas id="availabilityChart"></canvas>
            </div>
        </div>
    </div>

    {* Participation effective : filtre de période + toggle moyenne / total *}
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">{='participation.title'|translate}</h5>
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-auto">
                        <label class="form-label" for="startDate">{='participation.startDate'|translate}</label>
                        <input type="date" class="form-control" id="startDate" name="startDate" value="{$selectedStartDate}">
                    </div>
                    <div class="col-auto">
                        <label class="form-label" for="range">{='participation.range'|translate}</label>
                        <select class="form-select" id="range" name="range">
                            {foreach $rangeOptions as $key => $label}
                                <option value="{$key}" {if $key === $selectedRange}selected{/if}>{$label}</option>
                            {/foreach}
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">{='participation.apply'|translate}</button>
                    </div>
                </form>

                {* Hors du <form> pour que participationMode ne soit pas ajouté à l'URL *}
                <div class="btn-group ms-auto" role="group" aria-label="{='participation.title'|translate}">
                    <input type="radio" class="btn-check" name="participationMode" id="modeAverage" value="average" autocomplete="off" checked>
                    <label class="btn btn-outline-primary" for="modeAverage">{='participation.average'|translate}</label>

                    <input type="radio" class="btn-check" name="participationMode" id="modeTotal" value="total" autocomplete="off">
                    <label class="btn btn-outline-primary" for="modeTotal">{='participation.total'|translate}</label>
                </div>
            </div>

            <div style="position: relative; height: 360px; width: 100%;">
                <canvas id="participationChart"></canvas>
            </div>
        </div>
    </div>
</div>
{include 'partials/eventDetailModal.latte'}
{/block}

{block scripts}
<script>
window.availabilityChartData = {$chartData};
window.participationChartData = {$participationChartData};
window.selectedRange = {$selectedRange};
window.selectedStartDate = {$selectedStartDate};
{if isset($i18n)}
Object.assign(window.i18n, {=$i18n});
{/if}
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
<script type="module" src="{='/app/modules/Event/js/availability_stats.js'|version}"></script>
{/block}