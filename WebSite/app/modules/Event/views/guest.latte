{extends $layout}

{block title}{='event.guest.title'|translate}{/block}

{block content}
    {if $message !== ''}
        <div class="alert alert-{if $messageType === 'success'}success{else}danger{/if} alert-dismissible">
            {$message}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{='common.close'|translate}"></button>
        </div>
    {/if}
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h4 class="mb-0">{='event.guest.card_title'|translate}</h4>
                    </div>
                    <div class="card-body">
                        <form id="invitationForm" method="POST" action="/events/guest">
                            <div class="mb-3">
                                <label for="email" class="form-label">{='event.guest.email_label'|translate}</label>
                                <input type="email" class="form-control" id="email" name="email" required>
                                <div class="invalid-feedback">{='event.guest.email_invalid'|translate}</div>
                            </div>
                            <div class="mb-3">
                                <label for="nickname" class="form-label">{='event.guest.name_label'|translate}</label>
                                <input type="text" class="form-control" id="nickname" name="nickname" placeholder="{='event.guest.name_placeholder'|translate}">
                            </div>
                            <div class="mb-3">
                                <label for="event" class="form-label">{='event.guest.event_label'|translate}</label>
                                <select class="form-select" id="event" name="eventId" required>
                                    <option value="">{='event.guest.event_placeholder'|translate}</option>
                                    {foreach $events as $event}
                                        <option value="{$event->id}">{$event->summary} - {$event->startTime|shortDateTime} - {$event->personName}</option>
                                    {/foreach}
                                </select>
                                <div class="invalid-feedback">{='event.guest.event_invalid'|translate}</div>
                            </div>
                            <div class="d-flex justify-content-center gap-2">
                                <button type="submit" class="btn btn-primary">{='event.guest.send'|translate}</button>
                                <a href="/eventManager" class="btn btn-secondary">{='cancel'|translate}</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{/block}

{block scripts}
<script src="{='/app/modules/Event/js/guest.js'|version}"></script>
{/block}