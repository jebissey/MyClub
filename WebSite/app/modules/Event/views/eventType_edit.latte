{extends '../../Designer/views/designer.latte'}

{block content}
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title h5 m-0">{='event.types.edit.title'|translate}</h2>
                </div>
                <div class="card-body">
                    <form method="POST">
                        <div class="mb-3">
                            <label for="name" class="form-label">{='event.types.edit.name'|translate}</label>
                            <input type="text" class="form-control"
                                id="name" name="name" value="{$name}" required
                                data-required-message="{='event.types.edit.name_required'|translate}">
                            <div class="invalid-feedback">{='event.types.edit.name_required'|translate}</div>
                        </div>

                        <div class="mb-3">
                            <label for="itemGroup" class="form-label">{='event.types.edit.group'|translate}</label>
                            <select class="form-select" id="itemGroup">
                                <option value="">{='event.types.edit.group_none'|translate}</option>
                                {foreach $groups as $group}
                                <option value="{$group->id}" {if $group->id == $idGroup}selected{/if}>
                                    {$group->name}
                                </option>
                                {/foreach}
                            </select>
                            <input type="hidden" id="idGroup" name="idGroup" value="{$idGroup}">
                        </div>

                        <div class="card-body">
                            <div class="card-header">
                                <h2 class="card-title h5 m-0">{='event.types.attributes.title'|translate}</h2>
                            </div>
                            <div class="card-body">
                                <div class="row" id="attributeContainer">
                                {foreach $attributes as $attribute}
                                    <div class="col-md-4 mb-2">
                                        <div class="form-check">
                                            <input class="form-check-input" 
                                                type="checkbox" 
                                                name="attributes[]" 
                                                id="attribute{$attribute->id}" 
                                                value="{$attribute->id}"
                                                {if in_array($attribute->id, $existingAttributesIds)}checked{/if}>
                                            <label class="form-check-label" 
                                                for="attribute{$attribute->id}"
                                                data-bs-toggle="tooltip" 
                                                title="{$attribute->detail}">
                                                <span class="d-inline-block me-2" style="width: 20px; height: 20px; background-color: {$attribute->color};"></span>
                                                {$attribute->name}
                                            </label>
                                        </div>
                                    </div>
                                {/foreach}
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/eventTypes" class="btn btn-secondary">{='event.types.edit.cancel'|translate}</a>
                            <button type="submit" class="btn btn-primary">{='event.types.edit.save'|translate}</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{/block}

{block scripts}
<script n:syntax="off">
    document.addEventListener("DOMContentLoaded", function () {
        const nameInput = document.getElementById("name");

        nameInput.addEventListener("invalid", function () {
            this.setCustomValidity(this.dataset.requiredMessage ?? "");
        });

        nameInput.addEventListener("input", function () {
            this.setCustomValidity("");
        });

        document.getElementById('itemGroup').addEventListener('change', function() {
            document.getElementById('idGroup').value = this.value;
        });
    });
</script>
{/block}