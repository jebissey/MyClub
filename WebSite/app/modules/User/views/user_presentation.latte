{extends "user.latte"}

{block head}
<style>
.presentation-content img.img-left {
    float: left;
    margin-right: 10px;
    margin-bottom: 5px;
    max-width: 100%;
    height: auto;
}

.presentation-content img.img-right {
    float: right;
    margin-left: 10px;
    margin-bottom: 5px;
    max-width: 100%;
    height: auto;
}
</style>
{/block}

{block content}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">                    
                    {if $person->useGravatar && $person->email}
                    <img src="{$personImg}" class="rounded-circle"
                        alt="{='user.presentation.avatar_alt'|translate}"
                        data-bs-toggle="tooltip" 
                        data-bs-placement="bottom" 
                        title="{if $userEmail != ''}{='my_data'|translate}{else}{='login'|translate}{/if}">
                    {elseif $person->avatar}
                    <span data-bs-toggle="tooltip" 
                          data-bs-placement="bottom" 
                          title="{if $userEmail != ''}{='my_data'|translate}{else}{='login'|translate}{/if}"
                          style="font-size: 2rem; cursor: pointer; display: inline-block; line-height: 1;">
                        {$personImg}
                    </span>
                    {else}
                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 48px; height: 48px;">
                        <i class="bi bi-person-circle" style="font-size: 4rem;"></i>
                    </div>
                    {/if}
                    
                    <h3>{$person->firstName} {$person->lastName}</h3>
                    {if $person->nickName}
                        <p class="text-muted">{$person->nickName}</p>
                    {/if}
                    
                    {if $loggedPerson && $loggedPerson->id == $person->id}
                        <a href="/user/presentation/edit" class="btn btn-sm btn-primary mt-2">
                            <i class="bi bi-pencil"></i> {='user.presentation.edit_mine'|translate}
                        </a>
                    {/if}
                </div>
            </div>
            
            {if $person->location !== null && $person->location !== '' }
                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="card-title mb-0">{='user.presentation.neighborhood'|translate}</h5>
                    </div>
                    <div class="card-body p-0">
                        <div id="map" style="height: 200px;"></div>
                    </div>
                </div>
            {/if}
            
            {if $person->phone || $person->email}
                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="card-title mb-0">{='user.presentation.contact'|translate}</h5>
                    </div>
                    <div class="card-body">
                    {if $person->showPhoneInPresentationDirectory && $person->phone}
                        <p><i class="bi bi-telephone"></i> {$person->phone}</p>
                    {/if}
                    {if $person->showEmailInPresentationDirectory && $person->email}
                        <p><i class="bi bi-envelope"></i> {$person->email}</p>
                    {/if}
                    {if !$person->showPhoneInPresentationDirectory && !$person->showEmailInPresentationDirectory}
                        <p class="text-muted"><i class="bi bi-lock"></i> {='user.presentation.contact_not_shared'|translate}</p>
                    {/if}
                    </div>
                </div>
            {/if}
        </div>
        
        <div class="col-md-9">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">{='user.presentation.title'|translate}</h5>
                </div>
                <div class="card-body">
                {if $presentation !== ''}
                <div class="presentation-content">
                    {$presentation|noescape}
                </div>
                {else}
                <p class="text-muted">{='user.presentation.none_available'|translate}</p>
                {/if}
                </div>
            </div>
        </div>
    </div>
</div>
{/block}

{block scripts}
{if $person->location}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script>
            const locationStr = {$person->location};
            const mapMaxZoom = {$maxZoom};
    </script>
    <script src="{='/app/modules/User/js/presentation.js'|version}"></script>
{/if}
{/block}
