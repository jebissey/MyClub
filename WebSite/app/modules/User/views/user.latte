    ['page' => 'availabilities', 'href' => '/user/availabilities',   'icon' => '🕒', 'label' => 'navbar.user.availabilities'],
    ['page' => 'groups',         'href' => '/user/groups',           'icon' => '🔐', 'label' => 'navbar.user.groups'],
    ['page' => 'preferences',    'href' => '/user/preferences',      'icon' => '⭐', 'label' => 'navbar.user.preferences'],
    ['page' => 'notifications',  'href' => '/user/notifications',    'icon' => '🔔', 'label' => 'navbar.user.notifications'],
    ['page' => 'statistics',     'href' => '/user/statistics',       'icon' => '📊', 'label' => 'navbar.user.statistics'],
    ['page' => 'directory',      'href' => '/user/presentation/edit','icon' => '🎭', 'label' => 'navbar.user.directory'],
    ['page' => 'news',           'href' => '/user/news',             'icon' => '📰', 'label' => 'navbar.user.news'],
    ['page' => 'messages',       'href' => '/user/messages',         'icon' => '💬', 'label' => 'navbar.user.messages'],
