{extends "user.latte"}

{block title}{='user.ffa.title'|translate}{/block}

{block navbar}
{include '../../Common/views/navbar/home.latte'}
{/block}

{block content}
    <div class="container mt-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5>{='user.ffa.search_title'|translate}</h5>
            </div>
            <div class="card-body">
                <form method="get" action="/ffa/search">
                    <input type="hidden" name="question" id="question" value="rank">

                    <div class="row">
                        <div class="col-md-5">
                            <div class="form-group">
                                <label for="firstName">{='user.ffa.first_name'|translate}</label>
                                <input type="text" class="form-control" id="firstName" name="firstName" value="{$firstName}">
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-group">
                                <label for="lastName">{='user.ffa.last_name'|translate}</label>
                                <input type="text" class="form-control" id="lastName" name="lastName" value="{$lastName}">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-5">
                            <div class="form-group">
                                <label for="year">{='user.ffa.year'|translate}</label>
                                <input type="number" class="form-control" id="year" name="year" value="{$year}">
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-group">
                                <label for="club">{='user.ffa.club'|translate}</label>
                                <input type="text" class="form-control" id="club" name="club" value="{$club}">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100" onclick="setQuestion('rank')">{='user.ffa.rank'|translate}</button>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100" onclick="setQuestion('results')">{='user.ffa.results'|translate}</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        {if $error !== null}
            <div class="alert alert-danger">
                <strong>{='user.ffa.error'|translate}</strong> {$error}
            </div>
        {elseif $question === 'rank' && $rank !== null}
            <div class="card">
                <div class="card-header">
                    <h5>{='user.ffa.rank'|translate}</h5>
                </div>
                <div class="card-body">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>{='user.ffa.rank'|translate}</th>
                                <th>{='user.ffa.event'|translate}</th>
                                <th>{='user.ffa.last_name'|translate}</th>
                                <th>{='user.ffa.club'|translate}</th>
                                <th>{='user.ffa.points'|translate}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>{$rank['rank']}</td>
                                <td>{$rank['event']}</td>
                                <td>{$rank['name']}</td>
                                <td>{$rank['club']}</td>
                                <td>{$rank['points']}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        {elseif $question !== 'rank' && $results !== []}
            <div class="card">
                <div class="card-header">
                    <h5>{='user.ffa.results'|translate}</h5>
                </div>
                <div class="card-body">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>{='user.ffa.date'|translate}</th>
                                <th>{='user.ffa.competition'|translate}</th>
                                <th>{='user.ffa.place'|translate}</th>
                                <th>{='user.ffa.time'|translate}</th>
                                <th>{='user.ffa.category'|translate}</th>
                                <th>{='user.ffa.round'|translate}</th>
                                <th>{='user.ffa.location'|translate}</th>
                                {if $firstName === '' && $lastName === ''}<th>{='user.ffa.last_name'|translate}</th>{/if}
                            </tr>
                        </thead>
                        <tbody>
                            {foreach $results as $result}
                            <tr>
                                <td>{$result['date']}</td>
                                <td>{$result['competition']}</td>
                                <td>{$result['place']}</td>
                                <td>{$result['time']}</td>
                                <td>{$result['category']}</td>
                                <td>{$result['round']}</td>
                                <td>{$result['location']}</td>
                                {if $firstName === '' && $lastName === ''}<td>{$result['name']}</td>{/if}
                            </tr>
                            {/foreach}
                        </tbody>
                    </table>
                </div>
            </div>
        {elseif $firstName !== '' && $lastName !== ''}
            <div class="alert alert-warning">
                {='user.ffa.no_result'|translate}
            </div>
        {/if}
    </div>
{/block}

{block scripts}
<script>
    function setQuestion(question) {
        document.getElementById('question').value = question;
    }
</script>
{/block}